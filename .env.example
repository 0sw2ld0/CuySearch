# Motores, en orden: "auto" o una lista separada por comas.
# Disponibles: duckduckgo, bing, brave, mojeek, wikipedia, searxng, ollama,
# brave_api, tavily, exa.
CUYSEARCH_MOTORES=auto

# SearXNG propio (opcional). Si está, "auto" lo prueba primero.
# En el servicio se llama SEARXNG_BASE_URL; en la librería, CUYSEARCH_SEARXNG_URL.
SEARXNG_BASE_URL=
CUYSEARCH_SEARXNG_URL=

# Claves propias (opcionales). Brave, Tavily y Exa entran en "auto" si hay clave;
# Ollama sólo si se pide por nombre (CUYSEARCH_MOTORES=ollama,...).
OLLAMA_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=

# --- Servicio HTTP (extra [servicio]) ---
# Si queda vacío, la API no exige autenticación.
CUYSEARCH_API_KEY=
CUYSEARCH_HOST=127.0.0.1
CUYSEARCH_PORT=8090
CUYSEARCH_LOG_LEVEL=info

CUYSEARCH_REQUEST_TIMEOUT_SECONDS=15
CUYSEARCH_EXTRACT_TIMEOUT_SECONDS=20
CUYSEARCH_MAX_FETCH_BYTES=1000000
CUYSEARCH_MAX_CONTENT_CHARS=8000
CUYSEARCH_MAX_REDIRECTS=3
CUYSEARCH_CACHE_TTL_SECONDS=300
CUYSEARCH_CACHE_MAX_ENTRIES=32
CUYSEARCH_MAX_CONCURRENT_EXTRACTIONS=2
CUYSEARCH_HTTP_KEEPALIVE_CONNECTIONS=1

# Lista separada por comas. Vacío = sin CORS explícito.
CUYSEARCH_CORS_ORIGINS=
